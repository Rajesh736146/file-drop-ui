---
const { active = '' } = Astro.props;
---
<header class="topbar">
  <a class="brand" href="/" aria-label="Onlne File Share home">
    <img class="brand-mark" src="/favicon.svg" alt="" width="24" height="24" />
    <span>Onlne File Share</span>
  </a>
  <div class="topbar-right">
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle theme">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <nav class="top-actions" aria-label="Primary">
      <a class={active === 'upload' ? 'active' : ''} href="/upload">Upload</a>
      <a class={active === 'retrieve' ? 'active' : ''} href="/retrieve">Retrieve</a>
      <a class={active === 'privacy' ? 'active' : ''} href="/privacy">Privacy</a>
      <a class={active === 'contact' ? 'active' : ''} href="/contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--body);
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .theme-toggle:hover {
    background: var(--btn-bg);
    color: var(--btn-color);
    border-color: var(--btn-bg);
  }

  /* Light mode: show moon (click to go dark), hide sun */
  .icon-sun { display: none; }
  .icon-moon { display: block; }

  /* Dark mode: show sun (click to go light), hide moon */
  :global([data-theme="dark"]) .icon-sun { display: block; }
  :global([data-theme="dark"]) .icon-moon { display: none; }
</style>

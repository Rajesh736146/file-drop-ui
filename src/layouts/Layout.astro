---
import '../styles/global.css';

const {
	title = 'Onlne File Share - Online Fileshare for Secure File Sharing',
	description = 'Onlne File Share is a free online fileshare and secure file transfer tool for uploading files, sharing access keys, and downloading files through temporary links.',
	keywords = 'Online Fileshare, free online fileshare, file sharing, file transfer, cloud share, cloud storage, send large files, share files, secure file transfer, anonymous filesharing, p2p sharing, webtransfer free, dropbox alternative, send big files, link sharing app',
	image = '/favicon-96x96.png',
	type = 'website',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const imageUrl = new URL(image, Astro.site ?? Astro.url).toString();
const siteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Onlne File Share',
	alternateName: ['Online File Share', 'Online Fileshare', 'File Drop'],
	url: new URL('/', Astro.site ?? Astro.url).toString(),
	description:
		'Upload files from a browser, share access keys, and open temporary download links.',
	inLanguage: 'en',
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(function() {
				var saved = localStorage.getItem('theme');
				var hour = new Date().getHours();
				var isNight = hour >= 18 || hour < 6;
				if (!isNight) {
					localStorage.removeItem('theme');
					document.documentElement.setAttribute('data-theme', 'light');
					return;
				}
				if (saved) {
					document.documentElement.setAttribute('data-theme', saved);
					return;
				}
				document.documentElement.setAttribute('data-theme', 'dark');
			})();
		</script>
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="FileDrop" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:site_name" content="Onlne File Share" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />
		<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script>
			const toggle = document.getElementById('themeToggle');
			toggle?.addEventListener('click', () => {
				const current = document.documentElement.getAttribute('data-theme');
				const next = current === 'dark' ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', next);
				localStorage.setItem('theme', next);
			});
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
		font-family:
			Geist, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		background: #ffffff;
		color: #171717;
		font-synthesis: none;
		text-rendering: geometricPrecision;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	:global([data-theme="dark"]):root {
		background: #0a0a0f;
		color: #e8e8e8;
	}	

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	* {
		box-sizing: border-box;
	}

	button,
	input {
		font: inherit;
	}

	button {
		cursor: pointer;
	}

	a {
		color: inherit;
	}

	::selection {
		background: var(--selection-bg);
		color: var(--selection-color);
	}
</style>

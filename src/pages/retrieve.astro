---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page-shell">
		<header class="topbar">
			<a class="brand" href="/" aria-label="Onlne File Share home">
				<img class="brand-mark" src="/favicon.svg" alt="" width="24" height="24" />
				<span>Onlne File Share</span>
			</a>
			<nav class="top-actions" aria-label="Primary">
				<a href="/upload">Upload</a>
				<a class="active" href="/retrieve">Retrieve</a>
				<a href="/privacy">Privacy</a>
			</nav>
		</header>

		<section class="retrieve-layout">
			<section class="retrieve-card" aria-label="Retrieve a file">
				<p class="eyebrow">Download lookup</p>
				<h1>Enter a key to retrieve your file.</h1>
				<p class="subtitle">Use the alphanumeric access key or full file UUID you received after upload.</p>
				<form id="lookupForm" class="lookup-form">
					<input id="lookupKey" type="text" placeholder="Example: A7K9Q2" autocomplete="off" autofocus />
					<button type="submit">Find file</button>
				</form>
				<div id="lookupResult" class="lookup-result" hidden></div>
				<p id="lookupStatus" class="lookup-status">Ready to look up a file.</p>
			</section>

			<aside class="side-panel" aria-label="Retrieval notes">
				<div>
					<strong>Short keys</strong>
					<span>Short alphanumeric keys are enough when someone shares access with you.</span>
				</div>
				<div>
					<strong>Temporary links</strong>
					<span>Retrieved files open through expiring download URLs.</span>
				</div>
				<div>
					<strong>No account needed</strong>
					<span>The key is the handoff. Keep it private.</span>
				</div>
			</aside>
		</section>

		<script>
			const API_BASE = 'https://filedrop-nine.vercel.app';
			const lookupForm = document.querySelector('#lookupForm');
			const lookupKey = document.querySelector('#lookupKey');
			const lookupStatus = document.querySelector('#lookupStatus');
			const lookupResult = document.querySelector('#lookupResult');

			const formatBytes = (bytes) => {
				if (bytes >= 1024 * 1024 * 1024) return `${(bytes / 1024 / 1024 / 1024).toFixed(2)} GB`;
				if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
				return `${Math.max(1, Math.round(bytes / 1024))} KB`;
			};

			const startDownload = async (url, filename = 'download') => {
				try {
					const response = await fetch(url);
					if (!response.ok) throw new Error('Download request failed.');
					const blob = await response.blob();
					const objectUrl = URL.createObjectURL(blob);
					const anchor = document.createElement('a');
					anchor.href = objectUrl;
					anchor.download = filename;
					document.body.append(anchor);
					anchor.click();
					anchor.remove();
					URL.revokeObjectURL(objectUrl);
				} catch {
					window.location.href = url;
				}
			};

			const readError = async (response) => {
				try {
					const data = await response.json();
					return data.detail || `Request failed with ${response.status}`;
				} catch {
					return `Request failed with ${response.status}`;
				}
			};

			lookupForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const key = lookupKey?.value.trim();
				if (!key || !lookupStatus || !lookupResult) return;

				lookupStatus.textContent = 'Looking up file...';
				lookupResult.hidden = true;
				lookupResult.innerHTML = '';

				try {
					const response = await fetch(`${API_BASE}/api/files/${encodeURIComponent(key)}`);
					if (!response.ok) throw new Error(await readError(response));
					const file = await response.json();

					const name = document.createElement('strong');
					name.textContent = file.name;
					const meta = document.createElement('span');
					meta.textContent = `${formatBytes(file.size)} - expires ${new Date(file.expires_at).toLocaleString()}`;
					const link = document.createElement('a');
					link.href = file.download_url;
					link.rel = 'noreferrer';
					link.download = file.name;
					link.textContent = 'Download file';
					link.addEventListener('click', (downloadEvent) => {
						downloadEvent.preventDefault();
						startDownload(file.download_url, file.name);
					});
					lookupResult.append(name, meta, link);
					lookupResult.hidden = false;
					lookupStatus.textContent = 'File found.';
				} catch (error) {
					lookupStatus.textContent = error instanceof Error ? error.message : 'File lookup failed.';
				}
			});
		</script>
	</main>
</Layout>

<style>
	.page-shell {
		--ink: #171717;
		--body: #4d4d4d;
		--muted: #777777;
		--line: #eaeaea;
		--blue: #0070f3;
		position: relative;
		min-height: 100vh;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.032) 1px, transparent 1px),
			linear-gradient(180deg, rgba(0, 0, 0, 0.032) 1px, transparent 1px),
			radial-gradient(circle at 22% 10%, rgba(0, 112, 243, 0.14), transparent 26rem),
			linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
		background-size: 54px 54px, 54px 54px, auto, auto;
		color: var(--ink);
		animation: backgroundDrift 18s ease-in-out infinite alternate;
		overflow: hidden;
	}

	.page-shell::before,
	.page-shell::after {
		content: "";
		position: fixed;
		z-index: 0;
		width: 42vw;
		height: 42vw;
		min-width: 420px;
		min-height: 420px;
		border-radius: 50%;
		filter: blur(62px);
		opacity: 0.28;
		pointer-events: none;
	}

	.page-shell::before {
		left: -10vw;
		top: 18vh;
		background: radial-gradient(circle, rgba(0, 112, 243, 0.55), rgba(0, 223, 216, 0.2), transparent 68%);
		animation: blobOne 16s ease-in-out infinite alternate;
	}

	.page-shell::after {
		right: -12vw;
		top: 8vh;
		background: radial-gradient(circle, rgba(255, 0, 128, 0.42), rgba(249, 203, 40, 0.18), transparent 70%);
		animation: blobTwo 18s ease-in-out infinite alternate;
	}

	.topbar,
	.retrieve-layout {
		position: relative;
		z-index: 1;
	}

	@keyframes backgroundDrift {
		0% {
			background-position:
				0 0,
				0 0,
				0 0,
				0 0;
		}
		100% {
			background-position:
				18px 0,
				0 18px,
				90px 46px,
				0 0;
		}
	}

	@keyframes blobOne {
		0% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		100% {
			transform: translate3d(18vw, -8vh, 0) scale(1.16);
		}
	}

	@keyframes blobTwo {
		0% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		100% {
			transform: translate3d(-18vw, 14vh, 0) scale(1.12);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-shell,
		.page-shell::before,
		.page-shell::after {
			animation: none;
		}
	}

	[hidden] {
		display: none !important;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
		padding: 0 24px;
		border-bottom: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.84);
		backdrop-filter: blur(16px);
	}

	.brand,
	.top-actions {
		display: flex;
		align-items: center;
	}

	.brand {
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
		font-size: 15px;
		font-weight: 650;
	}

	.brand-mark {
		width: 24px;
		height: 24px;
		display: block;
		flex: 0 0 auto;
		border-radius: 6px;
	}

	.top-actions {
		gap: 6px;
	}

	.top-actions a {
		border-radius: 999px;
		padding: 8px 12px;
		color: var(--body);
		text-decoration: none;
		font-size: 14px;
	}

	.top-actions a.active,
	.top-actions a:hover {
		background: #171717;
		color: #ffffff;
	}

	.retrieve-layout {
		display: grid;
		grid-template-columns: minmax(460px, 720px) minmax(240px, 0.55fr);
		gap: 24px;
		align-items: stretch;
		width: min(1080px, calc(100% - 64px));
		margin: 0 auto;
		padding: 76px 0;
	}

	.retrieve-card,
	.side-panel {
		border: 1px solid var(--line);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.94);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.08);
	}

	.retrieve-card {
		padding: 32px;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--blue);
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 620px;
		margin-bottom: 16px;
		font-size: clamp(44px, 6vw, 74px);
		line-height: 1;
		letter-spacing: 0;
	}

	.subtitle {
		max-width: 560px;
		margin-bottom: 28px;
		color: var(--body);
		font-size: 18px;
		line-height: 29px;
	}

	.lookup-form {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 10px;
	}

	.lookup-form input {
		height: 50px;
		border: 1px solid #d4d4d4;
		border-radius: 6px;
		background: #ffffff;
		padding: 0 14px;
		font-size: 16px;
	}

	.lookup-form button,
	.lookup-result a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 50px;
		border: 1px solid #171717;
		border-radius: 6px;
		background: #171717;
		color: #ffffff;
		padding: 0 16px;
		text-decoration: none;
		font-size: 14px;
		font-weight: 500;
		white-space: nowrap;
	}

	.lookup-status {
		margin: 12px 2px 0;
		color: var(--muted);
		font-size: 14px;
	}

	.lookup-result {
		display: grid;
		gap: 8px;
		margin-top: 16px;
		border: 1px solid #dbeafe;
		border-radius: 8px;
		background: #f8fbff;
		padding: 16px;
	}

	.lookup-result strong,
	.lookup-result span {
		display: block;
	}

	.lookup-result span {
		color: var(--muted);
		font-size: 14px;
	}

	.lookup-result a {
		width: fit-content;
		margin-top: 6px;
	}

	.side-panel {
		display: grid;
		align-content: center;
	}

	.side-panel div {
		padding: 22px;
		border-bottom: 1px solid var(--line);
	}

	.side-panel div:last-child {
		border-bottom: 0;
	}

	.side-panel strong,
	.side-panel span {
		display: block;
	}

	.side-panel strong {
		font-size: 16px;
	}

	.side-panel span {
		margin-top: 7px;
		color: var(--muted);
		font-size: 14px;
		line-height: 22px;
	}

	@media (max-width: 860px) {
		.retrieve-layout {
			grid-template-columns: 1fr;
			width: min(720px, calc(100% - 32px));
		}
	}

	@media (max-width: 560px) {
		.lookup-form {
			grid-template-columns: 1fr;
		}
	}
</style>

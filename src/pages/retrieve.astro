---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
---

<Layout>
	<main class="page-shell">
		<Topbar active="retrieve" />

		<section class="retrieve-layout">
			<section class="retrieve-card" aria-label="Retrieve a file">
				<div class="lookup-title-row">
					<p class="eyebrow">Download lookup</p>
					<span>Look up file</span>
				</div>
				<h1>Enter a key to retrieve your file.</h1>
				<p class="subtitle">Use the alphanumeric access key or full file UUID you received after upload.</p>
				<form id="lookupForm" class="lookup-form">
					<input id="lookupKey" type="text" placeholder="Example: A7K9Q2" autocomplete="off" autofocus />
					<button type="submit">Find file</button>
				</form>
				<div id="lookupResult" class="lookup-result" hidden></div>
				<p id="lookupStatus" class="lookup-status">Ready to look up a file.</p>
			</section>

			<aside class="side-panel" aria-label="Retrieval notes">
				<div>
					<strong>Short keys</strong>
					<span>Short alphanumeric keys are enough when someone shares access with you.</span>
				</div>
				<div>
					<strong>Temporary links</strong>
					<span>Retrieved files open through expiring download URLs.</span>
				</div>
				<div>
					<strong>No account needed</strong>
					<span>The key is the handoff. Keep it private.</span>
				</div>
			</aside>
		</section>

		<script>
			const API_BASE = 'https://filedrop-nine.vercel.app';
			const lookupForm = document.querySelector('#lookupForm');
			const lookupKey = document.querySelector('#lookupKey');
			const lookupStatus = document.querySelector('#lookupStatus');
			const lookupResult = document.querySelector('#lookupResult');

			const formatBytes = (bytes: number) => {
				if (bytes >= 1024 * 1024 * 1024) return `${(bytes / 1024 / 1024 / 1024).toFixed(2)} GB`;
				if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
				return `${Math.max(1, Math.round(bytes / 1024))} KB`;
			};

			const startDownload = async (url: string, filename = 'download') => {
				try {
					const response = await fetch(url);
					if (!response.ok) throw new Error('Download request failed.');
					const blob = await response.blob();
					const objectUrl = URL.createObjectURL(blob);
					const anchor = document.createElement('a');
					anchor.href = objectUrl;
					anchor.download = filename;
					document.body.append(anchor);
					anchor.click();
					anchor.remove();
					URL.revokeObjectURL(objectUrl);
				} catch {
					window.location.href = url;
				}
			};

			const readError = async (response: any) => {
				try {
					const data = await response.json();
					return data.detail || `Request failed with ${response.status}`;
				} catch {
					return `Request failed with ${response.status}`;
				}
			};

			lookupForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const key = lookupKey?.value.trim();
				if (!key || !lookupStatus || !lookupResult) return;

				lookupStatus.textContent = 'Looking up file...';
				lookupResult.hidden = true;
				lookupResult.innerHTML = '';

				try {
					const response = await fetch(`${API_BASE}/api/files/${encodeURIComponent(key)}`);
					if (!response.ok) throw new Error(await readError(response));
					const file = await response.json();

					const name = document.createElement('strong');
					name.textContent = file.name;
					const meta = document.createElement('span');
					meta.textContent = `${formatBytes(file.size)} - expires ${new Date(file.expires_at).toLocaleString()}`;
					const link = document.createElement('a');
					link.href = file.download_url;
					link.rel = 'noreferrer';
					link.download = file.name;
					link.textContent = 'Download file';
					link.addEventListener('click', (downloadEvent) => {
						downloadEvent.preventDefault();
						startDownload(file.download_url, file.name);
					});
					lookupResult.append(name, meta, link);
					lookupResult.hidden = false;
					lookupStatus.textContent = 'File found.';
				} catch (error) {
					lookupStatus.textContent = error instanceof Error ? error.message : 'File lookup failed.';
				}
			});
		</script>
	</main>
</Layout>

<style>
	.retrieve-layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(460px, 720px) minmax(240px, 0.55fr); gap: 24px; align-items: stretch; width: min(1080px, calc(100% - 64px)); margin: 0 auto; padding: 76px 0; }
	.retrieve-card, .side-panel { border: 1px solid var(--line); border-radius: 8px; background: var(--card-bg); box-shadow: var(--shadow); }
	.retrieve-card { position: relative; border-color: transparent; background: linear-gradient(var(--surface-solid), var(--surface-solid)) padding-box, var(--gradient-border) border-box; box-shadow: 0 28px 90px rgba(0, 112, 243, 0.08), 0 0 0 4px rgba(0, 112, 243, 0.04); padding: 32px; overflow: hidden; }
	@media (prefers-color-scheme: dark) { .retrieve-card { box-shadow: 0 28px 90px rgba(245, 197, 24, 0.08), 0 0 0 4px rgba(245, 197, 24, 0.04); } }
	.retrieve-card::before { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(0, 112, 243, 0.06), transparent 34%), radial-gradient(circle at 88% 10%, rgba(0, 223, 216, 0.1), transparent 30%); pointer-events: none; }
	@media (prefers-color-scheme: dark) { .retrieve-card::before { background: linear-gradient(135deg, rgba(245, 197, 24, 0.06), transparent 34%), radial-gradient(circle at 88% 10%, rgba(245, 197, 24, 0.1), transparent 30%); } }
	.retrieve-card > * { position: relative; }
	.lookup-title-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 14px; }
	.lookup-title-row .eyebrow { margin-bottom: 0; }
	.lookup-title-row span { border: 1px solid var(--accent-dim); border-radius: 999px; background: var(--accent-dim); color: var(--accent); padding: 6px 10px; font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace; font-size: 11px; font-weight: 700; text-transform: uppercase; white-space: nowrap; }
	h1, p { margin-top: 0; }
	h1 { max-width: 620px; margin-bottom: 16px; font-size: clamp(44px, 6vw, 74px); line-height: 1; color: var(--ink); }
	.subtitle { max-width: 560px; margin-bottom: 28px; color: var(--body); font-size: 18px; line-height: 29px; }
	.lookup-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; }
	.lookup-form input { height: 50px; border: 1px solid var(--input-border); border-radius: 6px; background: var(--input-bg); padding: 0 14px; font-size: 16px; color: var(--ink); }
	.lookup-form input:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-dim); outline: none; }
	.lookup-form button, .lookup-result a { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; border: 1px solid var(--btn-bg); border-radius: 6px; background: var(--btn-bg); color: var(--btn-color); padding: 0 16px; text-decoration: none; font-size: 14px; font-weight: 600; white-space: nowrap; }
	.lookup-status { margin: 12px 2px 0; color: var(--muted); font-size: 14px; }
	.lookup-result { display: grid; gap: 8px; margin-top: 16px; border: 1px solid rgba(0, 112, 243, 0.2); border-radius: 8px; background: rgba(0, 112, 243, 0.04); padding: 16px; }
	@media (prefers-color-scheme: dark) { .lookup-result { border-color: rgba(245, 197, 24, 0.2); background: rgba(245, 197, 24, 0.05); } }
	.lookup-result strong, .lookup-result span { display: block; }
	.lookup-result strong { color: var(--ink); }
	.lookup-result span { color: var(--muted); font-size: 14px; }
	.lookup-result a { width: fit-content; margin-top: 6px; }
	.side-panel { display: grid; align-content: center; }
	.side-panel div { padding: 22px; border-bottom: 1px solid var(--line); }
	.side-panel div:last-child { border-bottom: 0; }
	.side-panel strong, .side-panel span { display: block; }
	.side-panel strong { font-size: 16px; color: var(--ink); }
	.side-panel span { margin-top: 7px; color: var(--muted); font-size: 14px; line-height: 22px; }
	@media (max-width: 860px) { .retrieve-layout { grid-template-columns: 1fr; width: min(720px, calc(100% - 32px)); } }
	@media (max-width: 560px) { .lookup-form { grid-template-columns: 1fr; } }
</style>

---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import FileTransferArticles from '../components/FileTransferArticles.astro';

const pageDescription =
	'Terms for using Onlne File Share for temporary browser-based file transfer, upload links, QR codes, and access keys.';
---

<Layout
	title="Terms and Conditions - Onlne File Share"
	description={pageDescription}
	keywords="file sharing terms, file transfer terms, access key sharing, temporary file upload"
>
	<main class="page-shell">
		<Topbar />

		<section class="content-page">
			<p class="eyebrow">Terms and conditions</p>
			<h1>Use Onlne File Share responsibly.</h1>
			<div class="content-card">
				<h2>Acceptable use</h2>
				<p>Do not upload illegal, harmful, abusive, infringing, or malicious content. You are responsible for the files you upload and the people you share access keys with.</p>
				<h2>Temporary access</h2>
				<p>Uploaded files are intended for temporary sharing. Download links and access keys may expire, change, or become unavailable.</p>
				<h2>No sensitive public sharing</h2>
				<p>Treat access keys like passwords. Do not post private keys publicly or share sensitive documents unless you understand the risks.</p>
				<h2>Service availability</h2>
				<p>The service is provided as a lightweight file sharing tool. Availability, upload behavior, and download access may depend on browser, network, storage, and API conditions.</p>
				<h2>Online file transfer expectations</h2>
				<p>Onlne File Share is for temporary browser-based transfer, not long-term storage. Keep your own copy of important files.</p>
				<h2>Sharing keys and links</h2>
				<p>Send file links, QR codes, and access keys through channels you trust. Do not publish them on public pages, comments, forums, or social profiles.</p>
			</div>
		</section>

		<FileTransferArticles />
	</main>
</Layout>

<style>
	.content-page { position: relative; z-index: 1; width: min(900px, calc(100% - 48px)); margin: 0 auto; padding: 72px 0; }
	h1 { margin: 0 0 24px; font-size: clamp(44px, 7vw, 76px); line-height: 1; color: var(--ink); }
	.content-card { border: 1px solid var(--line); border-radius: 8px; background: var(--card-bg); box-shadow: var(--shadow); padding: 28px; }
	.content-card h2 { margin: 0 0 8px; font-size: 22px; color: var(--ink); }
	.content-card p { margin: 0 0 22px; color: var(--body); font-size: 17px; line-height: 29px; }
	.content-card p:last-child { margin-bottom: 0; }
</style>

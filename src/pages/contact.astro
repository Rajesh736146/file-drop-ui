---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - Onlne File Share">
	<main class="page-shell">
		<header class="topbar">
			<a class="brand" href="/" aria-label="Onlne File Share home">
				<img class="brand-mark" src="/favicon.svg" alt="" width="24" height="24" />
				<span>Onlne File Share</span>
			</a>
			<nav class="top-actions" aria-label="Primary">
				<a href="/upload">Upload</a>
				<a href="/retrieve">Retrieve</a>
				<a href="/privacy">Privacy</a>
				<a class="active" href="/contact">Contact</a>
			</nav>
		</header>

		<section class="contact-page">
			<div>
				<p class="eyebrow">Contact us</p>
				<h1>Need help with Onlne File Share?</h1>
				<p class="subtitle">For questions, feedback, or support, contact Rajesh Sarkar using the details below.</p>
			</div>
			<section class="contact-card" aria-label="Contact details">
				<div class="photo-shell">
					<img
						class="contact-photo"
						src="/WhatsApp%20Image%202026-05-31%20at%204.54.27%20PM(1).jpeg"
						alt="Rajesh Sarkar"
						loading="eager"
					/>
				</div>
				<div>
					<span>Name</span>
					<strong>Rajesh Sarkar</strong>
				</div>
				<div>
					<span>Email</span>
					<a href="mailto:rajeshsarkar736146@gmail.com">rajeshsarkar736146@gmail.com</a>
				</div>
				<div>
					<span>Phone</span>
					<a href="tel:+918927544778">8927544778</a>
				</div>
			</section>
		</section>
	</main>
</Layout>

<style>
	.page-shell {
		--ink: #171717;
		--body: #4d4d4d;
		--muted: #777777;
		--line: #eaeaea;
		--blue: #0070f3;
		min-height: 100vh;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.032) 1px, transparent 1px),
			linear-gradient(180deg, rgba(0, 0, 0, 0.032) 1px, transparent 1px),
			radial-gradient(circle at 72% 12%, rgba(0, 112, 243, 0.14), transparent 28rem),
			linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
		background-size: 54px 54px, 54px 54px, auto, auto;
		color: var(--ink);
	}
	.topbar, .brand, .top-actions { display: flex; align-items: center; }
	.topbar { justify-content: space-between; height: 64px; padding: 0 24px; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.84); backdrop-filter: blur(16px); }
	.brand { gap: 10px; color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 650; }
	.brand-mark { width: 24px; height: 24px; display: block; flex: 0 0 auto; border-radius: 6px; }
	.top-actions { gap: 6px; }
	.top-actions a { border-radius: 999px; padding: 8px 12px; color: var(--body); text-decoration: none; font-size: 14px; }
	.top-actions a.active, .top-actions a:hover { background: #171717; color: #ffffff; }
	.contact-page { display: grid; grid-template-columns: minmax(0, .8fr) minmax(320px, 480px); gap: 36px; align-items: center; width: min(1080px, calc(100% - 48px)); margin: 0 auto; padding: 72px 0; }
	.eyebrow { margin: 0 0 14px; color: var(--blue); font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace; font-size: 12px; font-weight: 700; text-transform: uppercase; }
	h1 { margin: 0 0 18px; font-size: clamp(44px, 7vw, 76px); line-height: 1; letter-spacing: 0; }
	.subtitle { max-width: 540px; color: var(--body); font-size: 18px; line-height: 29px; }
	.contact-card { border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,.94); box-shadow: 0 24px 80px rgba(0,0,0,.08); overflow: hidden; }
	.photo-shell { padding: 18px 18px 0; background: linear-gradient(180deg, rgba(0,112,243,.08), rgba(255,255,255,0)); }
	.contact-photo { display: block; width: min(260px, 78%); aspect-ratio: 1; margin: 0 auto 18px; object-fit: cover; object-position: center 28%; border: 1px solid var(--line); border-radius: 50%; filter: saturate(.88) contrast(1.04); box-shadow: 0 18px 42px rgba(0,0,0,.12); }
	.contact-card div { padding: 22px; border-bottom: 1px solid var(--line); }
	.contact-card div:last-child { border-bottom: 0; }
	.contact-card span, .contact-card strong, .contact-card a { display: block; }
	.contact-card span { color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; }
	.contact-card strong, .contact-card a { margin-top: 8px; color: var(--ink); font-size: 20px; font-weight: 650; text-decoration: none; overflow-wrap: anywhere; }
	@media (max-width: 760px) { .contact-page { grid-template-columns: 1fr; } }
</style>

---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import '../styles/home.css';

const homeTitle = 'Onlne File Share - Online File Sharing, File Transfer, and File Drop';
const homeDescription =
	'Use Onlne File Share to upload a file, get a short access key, and share a download link. A simple online file sharing and file transfer page for quick file drops.';
const homeKeywords =
	'online file sharing, online file transfer, online file drop, file drop, file sharing, file transfer, file transfer online free, file transfer link, online file share without login, file sharing app, send large files, share files, secure file transfer, file transfer mobile to PC, online fileshare, free online fileshare, onlne file sharing, online file shaing, online file frop';
const faqItems = [
	{
		question: 'Why does my email say my file is too large to send, and how do I fix it?',
		answer:
			'Email services often block large attachments. Upload the file here, then send the key or download link instead of attaching the file.',
	},
	{
		question: 'Can I use this online file share tool without creating an account?',
		answer:
			'Yes. Upload the file, copy the access key, and share it. You do not need to create a storage workspace first.',
	},
	{
		question: 'How long do generated file-sharing links remain active?',
		answer:
			'The upload result shows an expiry time. Check that time before you send the link or key.',
	},
	{
		question: 'How secure is my data when uploading files to an online transfer tool?',
		answer:
			'Treat the access key like a password. Only send it to people who should be able to download the file.',
	},
	{
		question: 'Can I send an entire folder or multiple files at the same time?',
		answer:
			'For one link, put the folder or files into a ZIP and upload that ZIP. You can also upload files one by one.',
	},
	{
		question: 'Is there a limit on the size of files I can upload?',
		answer:
			'Large files are handled in parts behind the scenes. If a file is too big for email, try sending it from the upload page.',
	},
	{
		question: 'Can I send multiple files at once in a single link?',
		answer:
			'Yes, if you ZIP them first. One ZIP gives the recipient one download instead of several separate keys.',
	},
	{
		question: 'How do I password protect a file link before sharing it?',
		answer:
			'There is no separate password field right now. Keep the access key private and do not post it publicly.',
	},
	{
		question: 'Does this file transfer tool work on mobile devices and smartphones?',
		answer:
			'Yes. You can upload or retrieve files from a phone browser, tablet, or desktop browser.',
	},
	{
		question: 'Can I track if my shared file has been downloaded?',
		answer:
			'No download tracking is shown in the current interface.',
	},
	{
		question: 'Can I use this as a file transfer online free tool?',
		answer:
			'Yes. Upload from the browser, copy the key or file transfer link, and send it to the recipient.',
	},
	{
		question: 'How do I create a file transfer link?',
		answer:
			'Upload the file and wait for the success dialog. It shows the link, the key, and a QR code.',
	},
	{
		question: 'Can I transfer files from mobile to PC online?',
		answer:
			'Yes. Upload on your phone, then open the link, QR code, or key on your PC.',
	},
	{
		question: 'Is this a Send Anywhere or File transfer io alternative?',
		answer:
			'It can work as a small alternative when you only need a quick upload, a key, and a download link.',
	},
];
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};

const appSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Onlne File Share',
	url: 'https://onlnefileshare.com/',
	applicationCategory: 'UtilitiesApplication',
	operatingSystem: 'Any modern browser',
	description:
		'Upload files, create access keys, and share temporary download links from a browser.',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={homeTitle} description={homeDescription} keywords={homeKeywords}>
	<main class="app-shell">
		<Topbar />

		<section class="hero">
			<div class="hero-copy">
				<p class="live-status"><span aria-hidden="true"></span>Ready For Upload</p>
				<h1>Online file sharing without the extra setup.</h1>
				<p class="hero-subtitle">
					Choose a file, upload it, and share the access key or download link. Useful for quick
					file drops, online file transfer, and moving files between devices.
				</p>
			</div>

			<section class="upload-card transfer-card" id="upload" aria-label="Upload and retrieve files">
				<div class="transfer-upload">
					<div class="card-head">
						<div>
							<p>Storage target</p>
							<strong>Secure file storage</strong>
						</div>
						<span id="modePill">Ready</span>
					</div>

					<label class="dropzone">
						<input id="fileInput" type="file" />
						<span class="upload-icon" aria-hidden="true"><span></span></span>
						<strong id="fileTitle">Choose a file</strong>
						<small id="fileMeta">Large files are handled reliably in the background.</small>
					</label>

					<div class="progress-wrap" aria-label="Upload progress">
						<div class="progress-track">
							<span id="progressBar"></span>
						</div>
						<p id="statusText">Waiting for a file.</p>
					</div>

					<div class="result-box" id="resultBox" hidden>
						<div>
							<small>Access key</small>
							<strong id="accessKey">------</strong>
						</div>
						<a id="downloadLink" href="#" rel="noreferrer" data-download-link>Download file</a>
					</div>
				</div>

				<section class="lookup-card transfer-lookup" id="retrieve" aria-label="Retrieve a file">
					<div class="lookup-head">
						<span class="lookup-icon" aria-hidden="true"></span>
						<div>
							<p class="eyebrow">Download lookup</p>
							<h2>Have a key?</h2>
						</div>
						<span class="lookup-badge">Look up file</span>
					</div>
					<form id="lookupForm" class="lookup-form">
						<input id="lookupKey" type="text" placeholder="Enter access key or UUID" autocomplete="off" />
						<button type="submit">Find file</button>
					</form>
					<p id="lookupStatus" class="lookup-status">Paste an access key to open its download link.</p>
				</section>
			</section>
		</section>

		<details class="collapsible-section benefit-details" id="privacy">
			<summary>
				<span class="eyebrow">File sharing benefits</span>
				<strong>Why use this file transfer tool?</strong>
			</summary>
			<section class="benefit-grid" aria-label="File sharing benefits">
				<article>
					<h3>Simple sharing</h3>
					<p>Upload once and share a short access key with anyone who needs the file.</p>
				</article>
				<article>
					<h3>Large-file ready</h3>
					<p>Big uploads are split and sent safely so the experience stays stable.</p>
				</article>
				<article>
					<h3>Fast downloads</h3>
					<p>Files are stored on R2 and opened through temporary download links.</p>
				</article>
				<article>
					<h3>Private by default</h3>
					<p>Access keys expire, and the page only shows what people need to send or retrieve files.</p>
				</article>
			</section>
		</details>

		<details class="faq-section collapsible-section" aria-labelledby="faq-title">
			<summary>
				<span class="eyebrow">File sharing FAQ</span>
				<h2 id="faq-title">Questions about online file sharing</h2>
			</summary>
			<div class="faq-list">
				{
					faqItems.map((item) => (
						<article>
							<h3>{item.question}</h3>
							<p>{item.answer}</p>
						</article>
					))
					}
				</div>
		</details>

		<details class="seo-content collapsible-section" aria-labelledby="seo-title">
			<summary>
				<span class="eyebrow">Online file sharing</span>
				<h2 id="seo-title">Send a file without making it complicated</h2>
			</summary>
			<div class="seo-columns">
				<p>
					Onlne File Share is for the normal moments when you just need to send a file and move
					on. No folder setup, no team workspace, no long sign-up flow. Upload the file, get an
					access key, and send that key to the person who needs the download.
				</p>
				<p>
					It is useful when email rejects an attachment, a chat app compresses a video, or you
					want a quick online file transfer from your phone to your computer. After upload, the
					page shows a download link, an access key, and a QR code.
				</p>
				<p>
					This is not trying to be a full Dropbox replacement. It is closer to a small cloud share
					tool for one-time transfers: upload, share, retrieve. Someone with the key can use the
					retrieve page and download the file without learning a new app.
				</p>
				<p>
					People call this kind of page different things: online file sharing, online file
					transfer, file drop, fileshare, or a quick send-large-file link. The job is the same:
					put a file somewhere the other person can reach it.
				</p>
				<p>
					Access keys should be treated like temporary passwords. Share them privately, especially
					if the file is personal or work-related. The page shows the file name, size, link, and
					expiry so you know what you are sending before you pass it along.
				</p>
				<p>
					Use Upload when you are sending something. Use Retrieve when someone has already given
					you a key. The rest of the site explains the basics: how the sharing works, what to keep
					private, and where to ask for help.
				</p>
			</div>
		</details>

		<details class="related-searches collapsible-section" aria-labelledby="related-title">
			<summary>
				<span class="eyebrow">People also search for</span>
				<h2 id="related-title">Other ways people describe this</h2>
			</summary>
			<div class="related-grid">
				<article>
					<h3>File transfer online free</h3>
					<p>
						Upload from the browser and get a key or link without setting up a heavy storage
						account.
					</p>
				</article>
				<article>
					<h3>File transfer link</h3>
					<p>
						After upload, copy the file transfer link or use the QR code to open it on another
						device.
					</p>
				</article>
				<article>
					<h3>Online file share without login</h3>
					<p>
						For quick handoffs, upload the file, copy the key, and send it through a private
						channel.
					</p>
				</article>
				<article>
					<h3>File sharing app</h3>
					<p>
						The site keeps the basic file sharing actions in one place: upload, retrieve, copy,
						and download.
					</p>
				</article>
				<article>
					<h3>File transfer mobile to PC</h3>
					<p>
						Upload from a phone, scan the QR code, or enter the access key on your computer for
						a simple mobile to PC transfer.
					</p>
				</article>
				<article>
					<h3>Send Anywhere and File transfer io alternatives</h3>
					<p>
						If you only need a quick web upload and a download key, this is a small alternative
						to bigger transfer tools.
					</p>
				</article>
			</div>
		</details>

		<footer class="site-footer" aria-label="Footer navigation">
			<a href="/about">About us</a>
			<a href="/privacy">Privacy policy</a>
			<a href="/terms">Terms & conditions</a>
			<a href="/contact">Contact us</a>
		</footer>

		<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

		<div class="success-dialog" id="successDialog" hidden>
			<div class="dialog-backdrop" data-close-dialog></div>
			<section class="dialog-panel" role="dialog" aria-modal="true" aria-labelledby="successTitle">
				<button class="dialog-close" type="button" data-close-dialog aria-label="Close dialog">x</button>
				<div class="dialog-status" aria-hidden="true"></div>
				<p class="eyebrow">Upload complete</p>
				<h2 id="successTitle">Your file is ready to share.</h2>
				<p id="dialogFileMeta" class="dialog-meta">Copy the access key or share the download link.</p>

				<div class="download-options">
					<div class="option-row">
						<label for="dialogAccessKey">Access key</label>
						<div>
							<input id="dialogAccessKey" readonly />
							<button type="button" data-copy-target="dialogAccessKey">Copy key</button>
						</div>
					</div>
					<div class="option-row">
						<label for="dialogDownloadUrl">CDN download link</label>
						<div>
							<input id="dialogDownloadUrl" readonly />
							<button type="button" data-copy-target="dialogDownloadUrl">Copy link</button>
						</div>
					</div>
				</div>

				<div class="qr-section">
					<img id="dialogQr" alt="QR code for download link" />
					<div>
						<strong>Scan to download</strong>
						<span>QR code opens the generated CDN download link.</span>
						<div class="dialog-actions">
							<a id="dialogOpenLink" href="#" rel="noreferrer" data-download-link>Download file</a>
							<a id="dialogWhatsappShare" class="whatsapp-share" href="#" target="_blank" rel="noreferrer">Share on WhatsApp</a>
						</div>
					</div>
				</div>
			</section>
		</div>
	</main>

	<script>
		const API_BASE = 'https://filedrop-nine.vercel.app';
		const DIRECT_LIMIT = 5 * 1024 * 1024;

		const fileInput = document.querySelector('#fileInput');
		const fileTitle = document.querySelector('#fileTitle');
		const fileMeta = document.querySelector('#fileMeta');
		const modePill = document.querySelector('#modePill');
		const progressBar = document.querySelector('#progressBar');
		const statusText = document.querySelector('#statusText');
		const resultBox = document.querySelector('#resultBox');
		const accessKey = document.querySelector('#accessKey');
		const downloadLink = document.querySelector('#downloadLink');
		const lookupForm = document.querySelector('#lookupForm');
		const lookupKey = document.querySelector('#lookupKey');
		const lookupStatus = document.querySelector('#lookupStatus');
		const successDialog = document.querySelector('#successDialog');
		const dialogAccessKey = document.querySelector('#dialogAccessKey');
		const dialogDownloadUrl = document.querySelector('#dialogDownloadUrl');
		const dialogQr = document.querySelector('#dialogQr');
		const dialogOpenLink = document.querySelector('#dialogOpenLink');
		const dialogWhatsappShare = document.querySelector('#dialogWhatsappShare');
		const dialogFileMeta = document.querySelector('#dialogFileMeta');

		const formatBytes = (bytes) => {
			if (bytes >= 1024 * 1024 * 1024) return `${(bytes / 1024 / 1024 / 1024).toFixed(2)} GB`;
			if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
			return `${Math.max(1, Math.round(bytes / 1024))} KB`;
		};

		const startDownload = async (url, filename = 'download') => {
			try {
				const response = await fetch(url);
				if (!response.ok) throw new Error('Download request failed.');
				const blob = await response.blob();
				const objectUrl = URL.createObjectURL(blob);
				const anchor = document.createElement('a');
				anchor.href = objectUrl;
				anchor.download = filename;
				document.body.append(anchor);
				anchor.click();
				anchor.remove();
				URL.revokeObjectURL(objectUrl);
			} catch {
				window.location.href = url;
			}
		};

		const bindDownloadLink = (link, filename) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			link.download = filename || 'download';
			link.dataset.filename = filename || 'download';
		};

		const getRetrieveUrl = (accessKey) => {
			return `${window.location.origin}/retrieve/?key=${encodeURIComponent(accessKey)}`;
		};

		const setProgress = (value) => {
			if (progressBar) progressBar.style.inlineSize = `${Math.max(0, Math.min(100, value))}%`;
		};

		const setStatus = (message, mode = 'Ready') => {
			if (statusText) statusText.textContent = message;
			if (modePill) modePill.textContent = mode;
		};

		const uploadSmallFile = async (file) => {
			const form = new FormData();
			form.append('file', file);

			setProgress(18);
			const response = await fetch(`${API_BASE}/api/files/upload`, {
				method: 'POST',
				body: form,
			});

			if (!response.ok) throw new Error(await readError(response));
			setProgress(100);
			return response.json();
		};

		const uploadLargeFile = async (file) => {
			setStatus('Creating multipart upload in R2...', 'Multipart');
			const initiateResponse = await fetch(`${API_BASE}/api/files/upload/initiate`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					file_name: file.name,
					file_size: file.size,
					content_type: file.type || 'application/octet-stream',
				}),
			});

			if (!initiateResponse.ok) throw new Error(await readError(initiateResponse));
			const upload = await initiateResponse.json();
			const parts = [];

			for (let index = 0; index < upload.part_urls.length; index += 1) {
				const start = index * upload.chunk_size;
				const chunk = file.slice(start, Math.min(file.size, start + upload.chunk_size));
				setStatus(`Uploading chunk ${index + 1} of ${upload.num_parts}...`, 'Multipart');

				const partResponse = await fetch(upload.part_urls[index], {
					method: 'PUT',
					body: chunk,
				});

				if (!partResponse.ok) throw new Error(`Chunk ${index + 1} failed.`);

				parts.push({
					part_number: index + 1,
					etag: partResponse.headers.get('ETag') || partResponse.headers.get('etag') || '',
				});

				setProgress(((index + 1) / upload.num_parts) * 86);
			}

			setStatus('Finalizing upload...', 'Complete');
			const completeResponse = await fetch(`${API_BASE}/api/files/upload/complete`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					upload_id: upload.upload_id,
					r2_key: upload.r2_key,
					file_name: file.name,
					file_size: file.size,
					content_type: file.type || 'application/octet-stream',
					parts,
				}),
			});

			if (!completeResponse.ok) throw new Error(await readError(completeResponse));
			setProgress(100);
			return completeResponse.json();
		};

		const readError = async (response) => {
			try {
				const data = await response.json();
				return data.detail || `Request failed with ${response.status}`;
			} catch {
				return `Request failed with ${response.status}`;
			}
		};

		const showResult = (data) => {
			if (resultBox) resultBox.hidden = false;
			if (accessKey) accessKey.textContent = data.access_key;
			if (downloadLink) {
				downloadLink.href = data.download_url;
				bindDownloadLink(downloadLink, data.name);
			}
			setStatus(`${data.name} uploaded. Link expires ${new Date(data.expires_at).toLocaleString()}.`, 'Done');
			openSuccessDialog(data);
		};

		const openSuccessDialog = (data) => {
			if (!successDialog) return;
			if (dialogAccessKey) dialogAccessKey.value = data.access_key;
			if (dialogDownloadUrl) dialogDownloadUrl.value = data.download_url;
			if (dialogOpenLink) {
				dialogOpenLink.href = data.download_url;
				bindDownloadLink(dialogOpenLink, data.name);
			}
			if (dialogWhatsappShare instanceof HTMLAnchorElement) {
				const retrieveUrl = getRetrieveUrl(data.access_key);
				const shareText = `Your file is ready to download:\n${retrieveUrl}\n\nDirect download:\n${data.download_url}\n\nAccess key: ${data.access_key}`;
				dialogWhatsappShare.href = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
			}
			if (dialogQr) {
				dialogQr.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(data.download_url)}`;
			}
			if (dialogFileMeta) {
				dialogFileMeta.textContent = `${data.name} - ${formatBytes(data.size)} - expires ${new Date(data.expires_at).toLocaleString()}`;
			}
			successDialog.hidden = false;
			document.body.style.overflow = 'hidden';
		};

		const closeSuccessDialog = () => {
			if (!successDialog) return;
			successDialog.hidden = true;
			document.body.style.overflow = '';
		};

		document.querySelectorAll('[data-close-dialog]').forEach((control) => {
			control.addEventListener('click', closeSuccessDialog);
		});

		document.querySelectorAll('[data-copy-target]').forEach((button) => {
			button.addEventListener('click', async () => {
				const target = document.querySelector(`#${button.dataset.copyTarget}`);
				if (!(target instanceof HTMLInputElement)) return;
				await navigator.clipboard.writeText(target.value);
				button.textContent = 'Copied';
				window.setTimeout(() => {
					button.textContent = button.dataset.copyTarget === 'dialogAccessKey' ? 'Copy key' : 'Copy link';
				}, 1200);
			});
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeSuccessDialog();
		});

		document.addEventListener('click', (event) => {
			const link = event.target.closest('[data-download-link]');
			if (!(link instanceof HTMLAnchorElement) || !link.href || link.href.endsWith('#')) return;
			event.preventDefault();
			startDownload(link.href, link.dataset.filename || link.download || 'download');
		});

		fileInput?.addEventListener('change', async (event) => {
			const [file] = Array.from(event.target.files || []);
			if (!file) return;

			if (fileTitle) fileTitle.textContent = file.name;
			if (fileMeta) fileMeta.textContent = `${formatBytes(file.size)} • ${file.type || 'application/octet-stream'}`;
			if (resultBox) resultBox.hidden = true;
			setProgress(0);

			try {
				const isDirect = file.size < DIRECT_LIMIT;
				setStatus(isDirect ? 'Uploading directly...' : 'Preparing multipart upload...', isDirect ? 'Direct' : 'Multipart');
				const result = isDirect ? await uploadSmallFile(file) : await uploadLargeFile(file);
				showResult(result);
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Upload failed.', 'Error');
			}
		});

		lookupForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const key = lookupKey?.value.trim();
			if (!key || !lookupStatus) return;

			lookupStatus.textContent = 'Looking up file...';
			try {
				const response = await fetch(`${API_BASE}/api/files/${encodeURIComponent(key)}`);
				if (!response.ok) throw new Error(await readError(response));
				const file = await response.json();
				lookupStatus.innerHTML = '';

				const link = document.createElement('a');
				link.href = file.download_url;
				link.rel = 'noreferrer';
				link.download = file.name;
				link.dataset.downloadLink = '';
				link.dataset.filename = file.name;
				link.textContent = `Download ${file.name} (${formatBytes(file.size)})`;
				lookupStatus.append(link);
			} catch (error) {
				lookupStatus.textContent = error instanceof Error ? error.message : 'File lookup failed.';
			}
		});
	</script>
</Layout>

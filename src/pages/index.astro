---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import '../styles/home.css';

const homeTitle = 'Online Fileshare - Free Online File Sharing and Secure File Transfer';
const homeDescription =
	'Use Onlne File Share as a free online fileshare tool for secure file transfer, cloud share links, sending large files, and anonymous filesharing with temporary download keys.';
const homeKeywords =
	'Online Fileshare, free online fileshare, file sharing, fle transfer, file transfer, file transfer online free, file transfer link, online file share without login, file sharing app, Send Anywhere file transfer, File transfer io, file transfer mobile to PC, online file transfer Mobile to PC, cloud share, cloud storage, send large files, share files, secure file transfer, anonymous filesharing, p2p sharing, webtransfer free, dropbox alternative, send big files, link sharing app';
const faqItems = [
	{
		question: 'Why does my email say my file is too large to send, and how do I fix it?',
		answer:
			'Most email services limit attachments, so large videos, ZIP files, and folders can fail before they ever reach the recipient. With this online file share tool, you upload the file and send a download key or link instead of attaching the file directly to email.',
	},
	{
		question: 'Can I use this online file share tool without creating an account?',
		answer:
			'Yes. Onlne File Share is designed as a free online fileshare workflow for quick transfers. You can upload a file, receive an access key, and share it without creating a traditional cloud storage account.',
	},
	{
		question: 'How long do generated file-sharing links remain active?',
		answer:
			'Each upload returns an expiry time with the download details. The app shows that expiry after upload, so you can see how long the temporary link is expected to remain available before sharing it.',
	},
	{
		question: 'How secure is my data when uploading files to an online transfer tool?',
		answer:
			'The app uses a secure file transfer flow with temporary access keys and download links. Treat every access key like a temporary password and share it only through trusted channels.',
	},
	{
		question: 'Can I send an entire folder or multiple files at the same time?',
		answer:
			'The current upload flow is focused on reliable single-file transfer. If you need to share multiple files, compress them into a ZIP first or upload each file separately and share the generated keys.',
	},
	{
		question: 'Is there a limit on the size of files I can upload?',
		answer:
			'The upload experience supports large files by handling bigger uploads in parts behind the scenes. If your file is too large for email, this file sharing workflow is built to help send big files through a browser.',
	},
	{
		question: 'Can I send multiple files at once in a single link?',
		answer:
			'For one shareable link, place multiple items into one ZIP archive and upload that archive. This keeps the download simple for the recipient and works well for project folders, photos, and document bundles.',
	},
	{
		question: 'How do I password protect a file link before sharing it?',
		answer:
			'Password protection is not shown as a current page control. For now, keep access keys private, share them only with intended recipients, and avoid posting download keys publicly.',
	},
	{
		question: 'Does this file transfer tool work on mobile devices and smartphones?',
		answer:
			'Yes. The website is built for modern browsers, so you can use it on desktop or mobile to upload files, retrieve a shared access key, and open a download link.',
	},
	{
		question: 'Can I track if my shared file has been downloaded?',
		answer:
			'Download tracking is not shown in the current interface. The tool focuses on fast upload, link sharing, QR code sharing, and retrieval through an access key.',
	},
	{
		question: 'Can I use this as a file transfer online free tool?',
		answer:
			'Yes. Onlne File Share works as a file transfer online free tool for browser-based uploads and downloads. Upload a file, copy the generated access key or file transfer link, and share it with the recipient.',
	},
	{
		question: 'How do I create a file transfer link?',
		answer:
			'Upload your file and wait for the success dialog. The app shows a downloadable link, an access key, and a QR code so you can share the file transfer link in email, chat, or another trusted channel.',
	},
	{
		question: 'Can I transfer files from mobile to PC online?',
		answer:
			'Yes. You can upload from a mobile browser and open the same file on a PC by using the access key, download link, or QR code. This makes the tool useful for online file transfer mobile to PC workflows.',
	},
	{
		question: 'Is this a Send Anywhere or File transfer io alternative?',
		answer:
			'Onlne File Share offers a simple alternative for users searching for Send Anywhere file transfer, File transfer io, or a lightweight file sharing app. It focuses on upload, access key sharing, QR code sharing, and quick retrieval.',
	},
];
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<Layout title={homeTitle} description={homeDescription} keywords={homeKeywords}>
	<main class="app-shell">
		<Topbar />

		<section class="hero">
			<div class="hero-copy">
				<p class="live-status"><span aria-hidden="true"></span>Ready For Upload</p>
				<h1>Upload files. Share secure download keys.</h1>
				<p class="hero-subtitle">
					A clean file drop for quick sharing: choose a file, upload it securely, and share a
					short access key when it is ready.
				</p>
			</div>

			<section class="upload-card transfer-card" id="upload" aria-label="Upload and retrieve files">
				<div class="transfer-upload">
					<div class="card-head">
						<div>
							<p>Storage target</p>
							<strong>Secure file storage</strong>
						</div>
						<span id="modePill">Ready</span>
					</div>

					<label class="dropzone">
						<input id="fileInput" type="file" />
						<span class="upload-icon" aria-hidden="true"><span></span></span>
						<strong id="fileTitle">Choose a file</strong>
						<small id="fileMeta">Large files are handled reliably in the background.</small>
					</label>

					<div class="progress-wrap" aria-label="Upload progress">
						<div class="progress-track">
							<span id="progressBar"></span>
						</div>
						<p id="statusText">Waiting for a file.</p>
					</div>

					<div class="result-box" id="resultBox" hidden>
						<div>
							<small>Access key</small>
							<strong id="accessKey">------</strong>
						</div>
						<a id="downloadLink" href="#" rel="noreferrer" data-download-link>Download file</a>
					</div>
				</div>

				<section class="lookup-card transfer-lookup" id="retrieve" aria-label="Retrieve a file">
					<div class="lookup-head">
						<span class="lookup-icon" aria-hidden="true"></span>
						<div>
							<p class="eyebrow">Download lookup</p>
							<h2>Have a key?</h2>
						</div>
						<span class="lookup-badge">Look up file</span>
					</div>
					<form id="lookupForm" class="lookup-form">
						<input id="lookupKey" type="text" placeholder="Enter access key or UUID" autocomplete="off" />
						<button type="submit">Find file</button>
					</form>
					<p id="lookupStatus" class="lookup-status">Paste an access key to open its download link.</p>
				</section>
			</section>
		</section>

		<section class="benefit-grid" id="privacy" aria-label="File sharing benefits">
			<article>
				<h3>Simple sharing</h3>
				<p>Upload once and share a short access key with anyone who needs the file.</p>
			</article>
			<article>
				<h3>Large-file ready</h3>
				<p>Big uploads are split and sent safely so the experience stays stable.</p>
			</article>
			<article>
				<h3>Fast downloads</h3>
				<p>Files are stored on R2 and opened through temporary download links.</p>
			</article>
			<article>
				<h3>Private by default</h3>
				<p>Access keys expire, and the page only shows what people need to send or retrieve files.</p>
			</article>
		</section>

		<section class="faq-section" aria-labelledby="faq-title">
			<p class="eyebrow">File sharing FAQ</p>
			<h2 id="faq-title">Questions about online file sharing</h2>
			<div class="faq-list">
				{
					faqItems.map((item) => (
						<article>
							<h3>{item.question}</h3>
							<p>{item.answer}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="seo-content" aria-labelledby="seo-title">
			<p class="eyebrow">Online Fileshare</p>
			<h2 id="seo-title">A free online fileshare tool for fast, secure file sharing</h2>
			<div class="seo-columns">
				<p>
					Onlne File Share is built for anyone who needs a simple Online Fileshare experience
					without the clutter of a traditional cloud storage dashboard. Instead of creating an
					account, building folders, or inviting people into a workspace, you can upload a file,
					receive a short access key, and share that key with the person who needs the download.
					It is a free online fileshare workflow made for quick handoffs, temporary delivery,
					and moments when you want a clean link sharing app that stays focused on one job:
					move a file from you to someone else.
				</p>
				<p>
					The tool works well for everyday file sharing, whether you need to send large files,
					share files with a client, move a design export, deliver a video, or pass a document
					to another device. Large uploads are handled in the background so the page can remain
					responsive while the file is prepared. After upload, you get downloadable options,
					a CDN download link, an access key, and a QR code that can be scanned from another
					phone or computer. That makes Onlne File Share useful as a lightweight webtransfer
					free option when email attachments are too small or when a chat app compresses media.
				</p>
				<p>
					Many people search for a Dropbox alternative when they do not need a complete drive,
					sync client, or team storage suite. Onlne File Share is not trying to replace every
					cloud storage feature. It is closer to a focused cloud share utility: upload, share,
					retrieve, and move on. This approach is useful for one-time transfers, anonymous
					filesharing, and temporary link delivery. The interface also includes a retrieval page,
					so someone with an access key can quickly look up the file and start the download
					without learning a complicated product.
				</p>
				<p>
					Security and clarity matter in any secure file transfer flow. Onlne File Share keeps
					the visible experience straightforward by showing the access key, the generated
					download link, the file details, and the expiry time after upload. Users should treat
					access keys like temporary passwords and share them only through trusted channels.
					Compared with p2p sharing tools, this cloud-backed flow is easier for recipients
					who are not online at the same moment. Compared with full storage platforms, it is
					faster for simple delivery. If you need to send big files, create a temporary cloud
					share, or use a clean file transfer page from any browser, Onlne File Share gives you
					the core workflow without extra friction.
				</p>
				<p>
					The homepage, upload page, retrieval page, and privacy page are designed to make the
					process understandable. Upload is for creating a shareable file. Retrieve is for people
					who already have a key. Privacy explains what access keys mean and why you should keep
					them private. Together, these pages make the website useful for both senders and
					receivers. Whether you call it file sharing, file transfer, cloud share, anonymous
					filesharing, or a webtransfer free alternative, the goal is the same: make sharing a
					file feel fast, direct, and reliable.
				</p>
			</div>
		</section>

		<section class="related-searches" aria-labelledby="related-title">
			<p class="eyebrow">People also search for</p>
			<h2 id="related-title">Useful file transfer searches this tool supports</h2>
			<div class="related-grid">
				<article>
					<h3>File transfer online free</h3>
					<p>
						Use the browser upload flow when you need a file transfer online free option that
						creates a shareable key and download link without a complex account setup.
					</p>
				</article>
				<article>
					<h3>File transfer link</h3>
					<p>
						After upload, the success dialog shows a file transfer link, copy controls, and a QR
						code so recipients can open the download from another device.
					</p>
				</article>
				<article>
					<h3>Online file share without login</h3>
					<p>
						Onlne File Share is designed for quick online file share without login use cases:
						upload the file, copy the key, and send it through a trusted channel.
					</p>
				</article>
				<article>
					<h3>File sharing app</h3>
					<p>
						The website works like a lightweight file sharing app in the browser, with upload,
						retrieve, privacy, QR sharing, and download actions.
					</p>
				</article>
				<article>
					<h3>File transfer mobile to PC</h3>
					<p>
						Upload from a phone, scan the QR code, or enter the access key on your computer for
						online file transfer mobile to PC workflows.
					</p>
				</article>
				<article>
					<h3>Send Anywhere and File transfer io alternatives</h3>
					<p>
						If you are comparing Send Anywhere file transfer or File transfer io, this tool gives
						you a focused web-based alternative for quick upload and retrieval.
					</p>
				</article>
			</div>
		</section>

		<footer class="site-footer" aria-label="Footer navigation">
			<a href="/about">About us</a>
			<a href="/privacy">Privacy policy</a>
			<a href="/terms">Terms & conditions</a>
			<a href="/contact">Contact us</a>
		</footer>

		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

		<div class="success-dialog" id="successDialog" hidden>
			<div class="dialog-backdrop" data-close-dialog></div>
			<section class="dialog-panel" role="dialog" aria-modal="true" aria-labelledby="successTitle">
				<button class="dialog-close" type="button" data-close-dialog aria-label="Close dialog">x</button>
				<div class="dialog-status" aria-hidden="true"></div>
				<p class="eyebrow">Upload complete</p>
				<h2 id="successTitle">Your file is ready to share.</h2>
				<p id="dialogFileMeta" class="dialog-meta">Copy the access key or share the download link.</p>

				<div class="download-options">
					<div class="option-row">
						<label for="dialogAccessKey">Access key</label>
						<div>
							<input id="dialogAccessKey" readonly />
							<button type="button" data-copy-target="dialogAccessKey">Copy key</button>
						</div>
					</div>
					<div class="option-row">
						<label for="dialogDownloadUrl">CDN download link</label>
						<div>
							<input id="dialogDownloadUrl" readonly />
							<button type="button" data-copy-target="dialogDownloadUrl">Copy link</button>
						</div>
					</div>
				</div>

				<div class="qr-section">
					<img id="dialogQr" alt="QR code for download link" />
					<div>
						<strong>Scan to download</strong>
						<span>QR code opens the generated CDN download link.</span>
						<div class="dialog-actions">
							<a id="dialogOpenLink" href="#" rel="noreferrer" data-download-link>Download file</a>
							<a id="dialogWhatsappShare" class="whatsapp-share" href="#" target="_blank" rel="noreferrer">Share on WhatsApp</a>
						</div>
					</div>
				</div>
			</section>
		</div>
	</main>

	<script>
		const API_BASE = 'https://filedrop-nine.vercel.app';
		const DIRECT_LIMIT = 5 * 1024 * 1024;

		const fileInput = document.querySelector('#fileInput');
		const fileTitle = document.querySelector('#fileTitle');
		const fileMeta = document.querySelector('#fileMeta');
		const modePill = document.querySelector('#modePill');
		const progressBar = document.querySelector('#progressBar');
		const statusText = document.querySelector('#statusText');
		const resultBox = document.querySelector('#resultBox');
		const accessKey = document.querySelector('#accessKey');
		const downloadLink = document.querySelector('#downloadLink');
		const lookupForm = document.querySelector('#lookupForm');
		const lookupKey = document.querySelector('#lookupKey');
		const lookupStatus = document.querySelector('#lookupStatus');
		const successDialog = document.querySelector('#successDialog');
		const dialogAccessKey = document.querySelector('#dialogAccessKey');
		const dialogDownloadUrl = document.querySelector('#dialogDownloadUrl');
		const dialogQr = document.querySelector('#dialogQr');
		const dialogOpenLink = document.querySelector('#dialogOpenLink');
		const dialogWhatsappShare = document.querySelector('#dialogWhatsappShare');
		const dialogFileMeta = document.querySelector('#dialogFileMeta');

		const formatBytes = (bytes) => {
			if (bytes >= 1024 * 1024 * 1024) return `${(bytes / 1024 / 1024 / 1024).toFixed(2)} GB`;
			if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
			return `${Math.max(1, Math.round(bytes / 1024))} KB`;
		};

		const startDownload = async (url, filename = 'download') => {
			try {
				const response = await fetch(url);
				if (!response.ok) throw new Error('Download request failed.');
				const blob = await response.blob();
				const objectUrl = URL.createObjectURL(blob);
				const anchor = document.createElement('a');
				anchor.href = objectUrl;
				anchor.download = filename;
				document.body.append(anchor);
				anchor.click();
				anchor.remove();
				URL.revokeObjectURL(objectUrl);
			} catch {
				window.location.href = url;
			}
		};

		const bindDownloadLink = (link, filename) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			link.download = filename || 'download';
			link.dataset.filename = filename || 'download';
		};

		const getRetrieveUrl = (accessKey) => {
			return `${window.location.origin}/retrieve/?key=${encodeURIComponent(accessKey)}`;
		};

		const setProgress = (value) => {
			if (progressBar) progressBar.style.inlineSize = `${Math.max(0, Math.min(100, value))}%`;
		};

		const setStatus = (message, mode = 'Ready') => {
			if (statusText) statusText.textContent = message;
			if (modePill) modePill.textContent = mode;
		};

		const uploadSmallFile = async (file) => {
			const form = new FormData();
			form.append('file', file);

			setProgress(18);
			const response = await fetch(`${API_BASE}/api/files/upload`, {
				method: 'POST',
				body: form,
			});

			if (!response.ok) throw new Error(await readError(response));
			setProgress(100);
			return response.json();
		};

		const uploadLargeFile = async (file) => {
			setStatus('Creating multipart upload in R2...', 'Multipart');
			const initiateResponse = await fetch(`${API_BASE}/api/files/upload/initiate`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					file_name: file.name,
					file_size: file.size,
					content_type: file.type || 'application/octet-stream',
				}),
			});

			if (!initiateResponse.ok) throw new Error(await readError(initiateResponse));
			const upload = await initiateResponse.json();
			const parts = [];

			for (let index = 0; index < upload.part_urls.length; index += 1) {
				const start = index * upload.chunk_size;
				const chunk = file.slice(start, Math.min(file.size, start + upload.chunk_size));
				setStatus(`Uploading chunk ${index + 1} of ${upload.num_parts}...`, 'Multipart');

				const partResponse = await fetch(upload.part_urls[index], {
					method: 'PUT',
					body: chunk,
				});

				if (!partResponse.ok) throw new Error(`Chunk ${index + 1} failed.`);

				parts.push({
					part_number: index + 1,
					etag: partResponse.headers.get('ETag') || partResponse.headers.get('etag') || '',
				});

				setProgress(((index + 1) / upload.num_parts) * 86);
			}

			setStatus('Finalizing upload...', 'Complete');
			const completeResponse = await fetch(`${API_BASE}/api/files/upload/complete`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					upload_id: upload.upload_id,
					r2_key: upload.r2_key,
					file_name: file.name,
					file_size: file.size,
					content_type: file.type || 'application/octet-stream',
					parts,
				}),
			});

			if (!completeResponse.ok) throw new Error(await readError(completeResponse));
			setProgress(100);
			return completeResponse.json();
		};

		const readError = async (response) => {
			try {
				const data = await response.json();
				return data.detail || `Request failed with ${response.status}`;
			} catch {
				return `Request failed with ${response.status}`;
			}
		};

		const showResult = (data) => {
			if (resultBox) resultBox.hidden = false;
			if (accessKey) accessKey.textContent = data.access_key;
			if (downloadLink) {
				downloadLink.href = data.download_url;
				bindDownloadLink(downloadLink, data.name);
			}
			setStatus(`${data.name} uploaded. Link expires ${new Date(data.expires_at).toLocaleString()}.`, 'Done');
			openSuccessDialog(data);
		};

		const openSuccessDialog = (data) => {
			if (!successDialog) return;
			if (dialogAccessKey) dialogAccessKey.value = data.access_key;
			if (dialogDownloadUrl) dialogDownloadUrl.value = data.download_url;
			if (dialogOpenLink) {
				dialogOpenLink.href = data.download_url;
				bindDownloadLink(dialogOpenLink, data.name);
			}
			if (dialogWhatsappShare instanceof HTMLAnchorElement) {
				const retrieveUrl = getRetrieveUrl(data.access_key);
				const shareText = `Your file is ready to download:\n${retrieveUrl}\n\nDirect download:\n${data.download_url}\n\nAccess key: ${data.access_key}`;
				dialogWhatsappShare.href = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
			}
			if (dialogQr) {
				dialogQr.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(data.download_url)}`;
			}
			if (dialogFileMeta) {
				dialogFileMeta.textContent = `${data.name} - ${formatBytes(data.size)} - expires ${new Date(data.expires_at).toLocaleString()}`;
			}
			successDialog.hidden = false;
			document.body.style.overflow = 'hidden';
		};

		const closeSuccessDialog = () => {
			if (!successDialog) return;
			successDialog.hidden = true;
			document.body.style.overflow = '';
		};

		document.querySelectorAll('[data-close-dialog]').forEach((control) => {
			control.addEventListener('click', closeSuccessDialog);
		});

		document.querySelectorAll('[data-copy-target]').forEach((button) => {
			button.addEventListener('click', async () => {
				const target = document.querySelector(`#${button.dataset.copyTarget}`);
				if (!(target instanceof HTMLInputElement)) return;
				await navigator.clipboard.writeText(target.value);
				button.textContent = 'Copied';
				window.setTimeout(() => {
					button.textContent = button.dataset.copyTarget === 'dialogAccessKey' ? 'Copy key' : 'Copy link';
				}, 1200);
			});
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeSuccessDialog();
		});

		document.addEventListener('click', (event) => {
			const link = event.target.closest('[data-download-link]');
			if (!(link instanceof HTMLAnchorElement) || !link.href || link.href.endsWith('#')) return;
			event.preventDefault();
			startDownload(link.href, link.dataset.filename || link.download || 'download');
		});

		fileInput?.addEventListener('change', async (event) => {
			const [file] = Array.from(event.target.files || []);
			if (!file) return;

			if (fileTitle) fileTitle.textContent = file.name;
			if (fileMeta) fileMeta.textContent = `${formatBytes(file.size)} • ${file.type || 'application/octet-stream'}`;
			if (resultBox) resultBox.hidden = true;
			setProgress(0);

			try {
				const isDirect = file.size < DIRECT_LIMIT;
				setStatus(isDirect ? 'Uploading directly...' : 'Preparing multipart upload...', isDirect ? 'Direct' : 'Multipart');
				const result = isDirect ? await uploadSmallFile(file) : await uploadLargeFile(file);
				showResult(result);
			} catch (error) {
				setStatus(error instanceof Error ? error.message : 'Upload failed.', 'Error');
			}
		});

		lookupForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const key = lookupKey?.value.trim();
			if (!key || !lookupStatus) return;

			lookupStatus.textContent = 'Looking up file...';
			try {
				const response = await fetch(`${API_BASE}/api/files/${encodeURIComponent(key)}`);
				if (!response.ok) throw new Error(await readError(response));
				const file = await response.json();
				lookupStatus.innerHTML = '';

				const link = document.createElement('a');
				link.href = file.download_url;
				link.rel = 'noreferrer';
				link.download = file.name;
				link.dataset.downloadLink = '';
				link.dataset.filename = file.name;
				link.textContent = `Download ${file.name} (${formatBytes(file.size)})`;
				lookupStatus.append(link);
			} catch (error) {
				lookupStatus.textContent = error instanceof Error ? error.message : 'File lookup failed.';
			}
		});
	</script>
</Layout>

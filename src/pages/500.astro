---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
---

<Layout title="500 - Server Error | Onlne File Share">
	<main class="error-shell">
		<Topbar />

		<section class="error-content">
			<div class="error-code-wrap"><span class="error-code">500</span></div>
			<p class="eyebrow">Server error</p>
			<h1>Something went wrong on our end.</h1>
			<p class="error-subtitle">We're working on it. Please try again in a moment, or head back to the homepage.</p>
			<div class="error-actions">
				<a href="/" class="btn-primary">Go home</a>
				<button class="btn-secondary" onclick="window.location.reload()">Try again</button>
			</div>
		</section>
	</main>
</Layout>

<style>
	.error-shell { display: flex; flex-direction: column; }
	.error-content { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 48px 24px; }
	.error-code-wrap { margin-bottom: 24px; }
	.error-code { font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace; font-size: clamp(100px, 20vw, 180px); font-weight: 700; line-height: 1; letter-spacing: -4px; background: linear-gradient(135deg, #c83232, #ff6b6b, #c83232); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
	@media (prefers-color-scheme: dark) { .error-code { background: linear-gradient(135deg, #c83232, #f5c518, #c83232); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; } }
	.eyebrow { color: #c83232; }
	h1 { margin: 0 0 14px; font-size: clamp(32px, 5vw, 52px); line-height: 1.1; color: var(--ink); }
	.error-subtitle { max-width: 480px; margin: 0 0 32px; color: var(--body); font-size: 18px; line-height: 28px; }
	.error-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
	@media (max-width: 560px) { .error-actions { flex-direction: column; width: 100%; max-width: 280px; } }
</style>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - Onlne File Share">
	<main class="page-shell">
		<header class="topbar">
			<a class="brand" href="/" aria-label="Onlne File Share home">
				<img class="brand-mark" src="/favicon.svg" alt="" width="24" height="24" />
				<span>Onlne File Share</span>
			</a>
			<nav class="top-actions" aria-label="Primary">
				<a href="/upload">Upload</a>
				<a href="/retrieve">Retrieve</a>
				<a href="/privacy">Privacy</a>
				<a href="/contact">Contact</a>
			</nav>
		</header>

		<section class="content-page">
			<p class="eyebrow">About us</p>
			<h1>Built for quick, simple file sharing.</h1>
			<div class="content-card">
				<p>
					Onlne File Share is a lightweight web tool for uploading a file, generating a
					download key, and sharing that key with someone who needs access. The goal is to keep
					file transfer simple, fast, and understandable.
				</p>
				<p>
					The product is designed for people who do not want a full cloud storage workspace just
					to send one file. Upload, copy the key or download link, share it through a trusted
					channel, and let the recipient retrieve the file from the browser.
				</p>
				<p>
					We focus on a clean interface, clear access-key behavior, mobile-friendly retrieval,
					and practical sharing tools such as QR codes and temporary download links.
				</p>
			</div>
		</section>
	</main>
</Layout>

<style>
	.page-shell {
		--ink: #171717;
		--body: #4d4d4d;
		--muted: #777777;
		--line: #eaeaea;
		--blue: #0070f3;
		min-height: 100vh;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.032) 1px, transparent 1px),
			linear-gradient(180deg, rgba(0, 0, 0, 0.032) 1px, transparent 1px),
			radial-gradient(circle at 72% 12%, rgba(0, 112, 243, 0.14), transparent 28rem),
			linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
		background-size: 54px 54px, 54px 54px, auto, auto;
		color: var(--ink);
	}

	.topbar,
	.brand,
	.top-actions {
		display: flex;
		align-items: center;
	}

	.topbar {
		justify-content: space-between;
		height: 64px;
		padding: 0 24px;
		border-bottom: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.84);
		backdrop-filter: blur(16px);
	}

	.brand {
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
		font-size: 15px;
		font-weight: 650;
	}

	.brand-mark {
		width: 24px;
		height: 24px;
		display: block;
		flex: 0 0 auto;
		border-radius: 6px;
	}

	.top-actions {
		gap: 6px;
	}

	.top-actions a {
		border-radius: 999px;
		padding: 8px 12px;
		color: var(--body);
		text-decoration: none;
		font-size: 14px;
	}

	.top-actions a:hover {
		background: #171717;
		color: #ffffff;
	}

	.content-page {
		width: min(900px, calc(100% - 48px));
		margin: 0 auto;
		padding: 72px 0;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--blue);
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1 {
		margin: 0 0 24px;
		font-size: clamp(44px, 7vw, 76px);
		line-height: 1;
		letter-spacing: 0;
	}

	.content-card {
		border: 1px solid var(--line);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.94);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.08);
		padding: 28px;
	}

	.content-card p {
		margin: 0 0 16px;
		color: var(--body);
		font-size: 17px;
		line-height: 29px;
	}

	.content-card p:last-child {
		margin-bottom: 0;
	}
</style>

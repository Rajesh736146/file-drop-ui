---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import '../styles/home.css';
---

<Layout>
	<main class="page-shell">
		<Topbar active="upload" />

		<section class="upload-layout">
			<div class="page-copy">
				<p class="eyebrow">Secure upload</p>
				<h1>Upload your file and share the access key.</h1>
				<p>Choose a file, wait for the upload to finish, then send the generated key to anyone who needs the download.</p>
			</div>

			<section class="upload-card" aria-label="Upload file">
				<div class="card-head">
					<div>
						<p>Upload target</p>
						<strong>Secure file storage</strong>
					</div>
					<span id="modePill">Ready</span>
				</div>

				<label class="dropzone">
					<input id="fileInput" type="file" />
					<span class="upload-icon" aria-hidden="true"><span></span></span>
					<strong id="fileTitle">Choose a file</strong>
					<small id="fileMeta">Large files are handled reliably in the background.</small>
				</label>

				<div class="progress-wrap" aria-label="Upload progress">
					<div class="progress-track">
						<span id="progressBar"></span>
					</div>
					<p id="statusText">Waiting for a file.</p>
				</div>

				<div class="result-box" id="resultBox" hidden>
					<div>
						<small>Access key</small>
						<strong id="accessKey">------</strong>
					</div>
					<a id="downloadLink" href="#" rel="noreferrer" data-download-link>Download file</a>
				</div>
			</section>
		</section>

		<div class="success-dialog" id="successDialog" hidden>
			<div class="dialog-backdrop" data-close-dialog></div>
			<section class="dialog-panel" role="dialog" aria-modal="true" aria-labelledby="successTitle">
				<button class="dialog-close" type="button" data-close-dialog aria-label="Close dialog">x</button>
				<div class="dialog-status" aria-hidden="true"></div>
				<p class="eyebrow">Upload complete</p>
				<h2 id="successTitle">Your file is ready to share.</h2>
				<p id="dialogFileMeta" class="dialog-meta">Copy the access key or share the download link.</p>

				<div class="download-options">
					<div class="option-row">
						<label for="dialogAccessKey">Access key</label>
						<div>
							<input id="dialogAccessKey" readonly />
							<button type="button" data-copy-target="dialogAccessKey">Copy key</button>
						</div>
					</div>
					<div class="option-row">
						<label for="dialogDownloadUrl">CDN download link</label>
						<div>
							<input id="dialogDownloadUrl" readonly />
							<button type="button" data-copy-target="dialogDownloadUrl">Copy link</button>
						</div>
					</div>
				</div>

				<div class="qr-section">
					<img id="dialogQr" alt="QR code for download link" />
					<div>
						<strong>Scan to download</strong>
						<span>QR code opens the generated CDN download link.</span>
						<div class="dialog-actions">
							<a id="dialogOpenLink" href="#" rel="noreferrer" data-download-link>Download file</a>
							<a id="dialogWhatsappShare" class="whatsapp-share" href="#" target="_blank" rel="noreferrer">Share on WhatsApp</a>
						</div>
					</div>
				</div>
			</section>
		</div>

		<script>
			const API_BASE = 'https://filedrop-nine.vercel.app';
			const DIRECT_LIMIT = 5 * 1024 * 1024;
			const fileInput = document.querySelector<HTMLInputElement>('#fileInput');
			const fileTitle = document.querySelector<HTMLElement>('#fileTitle');
			const fileMeta = document.querySelector<HTMLElement>('#fileMeta');
			const modePill = document.querySelector<HTMLElement>('#modePill');
			const progressBar = document.querySelector<HTMLElement>('#progressBar');
			const statusText = document.querySelector<HTMLElement>('#statusText');
			const resultBox = document.querySelector<HTMLDivElement>('#resultBox');
			const accessKey = document.querySelector<HTMLElement>('#accessKey');
			const downloadLink = document.querySelector<HTMLAnchorElement>('#downloadLink');
			const successDialog = document.querySelector<HTMLDivElement>('#successDialog');
			const dialogAccessKey = document.querySelector<HTMLInputElement>('#dialogAccessKey');
			const dialogDownloadUrl = document.querySelector<HTMLInputElement>('#dialogDownloadUrl');
			const dialogQr = document.querySelector<HTMLImageElement>('#dialogQr');
			const dialogOpenLink = document.querySelector<HTMLAnchorElement>('#dialogOpenLink');
			const dialogWhatsappShare = document.querySelector<HTMLAnchorElement>('#dialogWhatsappShare');
			const dialogFileMeta = document.querySelector<HTMLElement>('#dialogFileMeta');

			const formatBytes = (bytes: number) => {
				if (bytes >= 1024 * 1024 * 1024) return `${(bytes / 1024 / 1024 / 1024).toFixed(2)} GB`;
				if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
				return `${Math.max(1, Math.round(bytes / 1024))} KB`;
			};

			const startDownload = async (url: string, filename = 'download') => {
				try {
					const response = await fetch(url);
					if (!response.ok) throw new Error('Download request failed.');
					const blob = await response.blob();
					const objectUrl = URL.createObjectURL(blob);
					const anchor = document.createElement('a');
					anchor.href = objectUrl;
					anchor.download = filename;
					document.body.append(anchor);
					anchor.click();
					anchor.remove();
					URL.revokeObjectURL(objectUrl);
				} catch {
					window.location.href = url;
				}
			};

			const bindDownloadLink = (link: HTMLAnchorElement, filename: string) => {
				link.download = filename || 'download';
				link.dataset.filename = filename || 'download';
			};

			const getRetrieveUrl = (accessKey: string) => {
				return `${window.location.origin}/retrieve/?key=${encodeURIComponent(accessKey)}`;
			};

			const readError = async (response: Response) => {
				try {
					const data = await response.json();
					return data.detail || `Request failed with ${response.status}`;
				} catch {
					return `Request failed with ${response.status}`;
				}
			};

			const setProgress = (value: number) => {
				if (progressBar) progressBar.style.inlineSize = `${Math.max(0, Math.min(100, value))}%`;
			};

			const setStatus = (message: string, mode = 'Ready') => {
				if (statusText) statusText.textContent = message;
				if (modePill) modePill.textContent = mode;
			};

			const openSuccessDialog = (data: any) => {
				if (!successDialog) return;
				if (dialogAccessKey) dialogAccessKey.value = data.access_key;
				if (dialogDownloadUrl) dialogDownloadUrl.value = data.download_url;
				if (dialogOpenLink) {
					dialogOpenLink.href = data.download_url;
					bindDownloadLink(dialogOpenLink, data.name);
				}
				if (dialogWhatsappShare) {
					const retrieveUrl = getRetrieveUrl(data.access_key);
					const shareText = `Your file is ready to download:\n${retrieveUrl}\n\nDirect download:\n${data.download_url}\n\nAccess key: ${data.access_key}`;
					dialogWhatsappShare.href = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
				}
				if (dialogQr) {
					dialogQr.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(data.download_url)}`;
				}
				if (dialogFileMeta) {
					dialogFileMeta.textContent = `${data.name} - ${formatBytes(data.size)} - expires ${new Date(data.expires_at).toLocaleString()}`;
				}
				successDialog.hidden = false;
				document.body.style.overflow = 'hidden';
			};

			const closeSuccessDialog = () => {
				if (!successDialog) return;
				successDialog.hidden = true;
				document.body.style.overflow = '';
			};

			document.querySelectorAll('[data-close-dialog]').forEach((control) => {
				control.addEventListener('click', closeSuccessDialog);
			});

			document.querySelectorAll('[data-copy-target]').forEach((button) => {
				if (!(button instanceof HTMLElement)) return;
				button.addEventListener('click', async () => {
					const target = document.querySelector(`#${button.dataset.copyTarget}`);
					if (!(target instanceof HTMLInputElement)) return;
					await navigator.clipboard.writeText(target.value);
					button.textContent = 'Copied';
					window.setTimeout(() => {
						button.textContent = button.dataset.copyTarget === 'dialogAccessKey' ? 'Copy key' : 'Copy link';
					}, 1200);
				});
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') closeSuccessDialog();
			});

			document.addEventListener('click', (event) => {
				const target = event.target instanceof Element ? event.target.closest('[data-download-link]') : null;
				if (!(target instanceof HTMLAnchorElement) || !target.href || target.href.endsWith('#')) return;
				event.preventDefault();
				startDownload(target.href, target.dataset.filename || target.download || 'download');
			});

			const uploadSmallFile = async (file: File) => {
				const form = new FormData();
				form.append('file', file);
				setProgress(18);
				const response = await fetch(`${API_BASE}/api/files/upload`, { method: 'POST', body: form });
				if (!response.ok) throw new Error(await readError(response));
				setProgress(100);
				return response.json();
			};

			const uploadLargeFile = async (file: File) => {
				setStatus('Preparing secure upload...', 'Uploading');
				const initiateResponse = await fetch(`${API_BASE}/api/files/upload/initiate`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ file_name: file.name, file_size: file.size, content_type: file.type || 'application/octet-stream' }),
				});
				if (!initiateResponse.ok) throw new Error(await readError(initiateResponse));
				const upload = await initiateResponse.json();
				const parts = [];
				for (let index = 0; index < upload.part_urls.length; index += 1) {
					const start = index * upload.chunk_size;
					const chunk = file.slice(start, Math.min(file.size, start + upload.chunk_size));
					setStatus(`Uploading part ${index + 1} of ${upload.num_parts}...`, 'Uploading');
					const partResponse = await fetch(upload.part_urls[index], { method: 'PUT', body: chunk });
					if (!partResponse.ok) throw new Error(`Part ${index + 1} failed.`);
					parts.push({ part_number: index + 1, etag: partResponse.headers.get('ETag') || partResponse.headers.get('etag') || '' });
					setProgress(((index + 1) / upload.num_parts) * 86);
				}
				setStatus('Finalizing upload...', 'Finalizing');
				const completeResponse = await fetch(`${API_BASE}/api/files/upload/complete`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ upload_id: upload.upload_id, r2_key: upload.r2_key, file_name: file.name, file_size: file.size, content_type: file.type || 'application/octet-stream', parts }),
				});
				if (!completeResponse.ok) throw new Error(await readError(completeResponse));
				setProgress(100);
				return completeResponse.json();
			};

			fileInput?.addEventListener('change', async (event) => {
				const input = event.currentTarget as HTMLInputElement;
				const [file] = Array.from(input.files || []);
				if (!file) return;
				if (fileTitle) fileTitle.textContent = file.name;
				if (fileMeta) fileMeta.textContent = `${formatBytes(file.size)} - ${file.type || 'application/octet-stream'}`;
				if (resultBox) resultBox.hidden = true;
				setProgress(0);
				try {
					const result = file.size < DIRECT_LIMIT ? await uploadSmallFile(file) : await uploadLargeFile(file);
					if (resultBox) resultBox.hidden = false;
					if (accessKey) accessKey.textContent = result.access_key;
					if (downloadLink) { downloadLink.href = result.download_url; bindDownloadLink(downloadLink, result.name); }
					setStatus(`${result.name} uploaded. Link expires ${new Date(result.expires_at).toLocaleString()}.`, 'Done');
					openSuccessDialog(result);
				} catch (error) {
					setStatus(error instanceof Error ? error.message : 'Upload failed.', 'Error');
				}
			});
		</script>
	</main>
</Layout>

<style>
	.upload-layout { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(320px, 0.65fr) minmax(460px, 680px); gap: 44px; align-items: center; width: min(1120px, calc(100% - 64px)); margin: 0 auto; padding: 64px 0; }
	h1, h2, p { margin-top: 0; }
	h1 { max-width: 500px; margin-bottom: 18px; font-size: clamp(44px, 6vw, 72px); line-height: 1; color: var(--ink); }
	.page-copy p:last-child { max-width: 430px; color: var(--body); font-size: 18px; line-height: 29px; }
	.card-head p, .card-head span { margin: 0; font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace; font-size: 12px; text-transform: uppercase; }
	.upload-card { border: 1px solid transparent; border-radius: 8px; background: linear-gradient(var(--surface-solid), var(--surface-solid)) padding-box, var(--gradient-border) border-box; box-shadow: var(--shadow); padding: 18px; }
	.card-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
	.card-head p { color: var(--muted); }
	.card-head strong { display: block; margin-top: 4px; font-size: 18px; color: var(--ink); }
	.card-head span { border: 1px solid var(--accent-dim); border-radius: 999px; background: var(--accent-dim); color: var(--accent); padding: 6px 10px; font-weight: 700; }
	.dropzone { position: relative; display: grid; place-items: center; min-height: 430px; border: 1px dashed var(--input-border); border-radius: 8px; background: radial-gradient(circle at 50% 48%, var(--accent-dim), transparent 46%), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px), linear-gradient(180deg, var(--grid-line) 1px, transparent 1px), var(--card-inner); background-size: auto, 36px 36px, 36px 36px; padding: 28px; text-align: center; cursor: pointer; transition: border-color 180ms ease, transform 180ms ease; }
	:global([data-theme="dark"]) .dropzone { border-color: var(--input-border); }
	.dropzone::before { content: ""; position: absolute; inset: 22px; border: 1px solid var(--accent-dim); border-radius: 8px; opacity: 0; transform: scale(0.96); pointer-events: none; }
	.dropzone:hover { border-color: var(--ink); transform: translateY(-1px); }
	:global([data-theme="dark"]) .dropzone:hover { border-color: var(--accent); }
	.dropzone input { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }
	.upload-icon { position: relative; display: grid; place-items: center; width: 88px; height: 88px; margin-bottom: 18px; border: 0; border-radius: 24px; background: var(--surface-solid); box-shadow: 0 18px 42px rgba(0, 0, 0, 0.1); overflow: hidden; transform: translateZ(0); }
	:global([data-theme="dark"]) .upload-icon { background: #1a1a28; box-shadow: 0 18px 42px rgba(0, 0, 0, 0.4); }
	.upload-icon span { position: absolute; inset: 3px; z-index: 1; border-radius: 21px; background: var(--surface-solid); }
	:global([data-theme="dark"]) .upload-icon span { background: #1a1a28; }
	.upload-icon::before { content: ""; position: absolute; inset: -28px; background: conic-gradient(from 0deg, #0070f3, #00dfd8, #ff0080, #f9cb28, #0070f3); transform: rotate(22deg); }
	:global([data-theme="dark"]) .upload-icon::before { background: conic-gradient(from 0deg, #f5c518, #c89600, #f5c518, #8b6914, #f5c518); }
	.upload-icon::after { content: ""; position: absolute; z-index: 2; left: 50%; top: 50%; width: 28px; height: 3px; background: var(--ink); transform: translate(-50%, -50%); }
	.upload-icon span::after { content: ""; position: absolute; left: 50%; top: 50%; width: 3px; height: 28px; background: var(--ink); transform: translate(-50%, -50%); }
	:global([data-theme="dark"]) .upload-icon::after, :global([data-theme="dark"]) .upload-icon span::after { background: var(--accent); }
	.dropzone strong { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 30px; color: var(--ink); }
	.dropzone small { display: block; max-width: 380px; margin-top: 8px; color: var(--muted); line-height: 21px; }
	.progress-wrap { margin-top: 14px; }
	.progress-track { height: 8px; overflow: hidden; border-radius: 999px; background: var(--line); }
	.progress-track span { display: block; inline-size: 0%; block-size: 100%; border-radius: inherit; background: var(--btn-bg); transition: inline-size 180ms ease; }
	.progress-wrap p { margin: 10px 2px 0; color: var(--muted); font-size: 13px; line-height: 20px; }
	.result-box { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 14px; border: 1px solid #dbeafe; border-radius: 8px; background: #f8fbff; padding: 14px; }
	:global([data-theme="dark"]) .result-box { border-color: rgba(245, 197, 24, 0.2); background: rgba(245, 197, 24, 0.05); }
	.result-box small, .result-box strong { display: block; }
	.result-box small { color: var(--muted); }
	.result-box strong { font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace; font-size: 24px; color: var(--accent); }
	.result-box a { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; border: 1px solid var(--btn-bg); border-radius: 6px; background: var(--btn-bg); color: var(--btn-color); padding: 0 14px; text-decoration: none; font-size: 14px; font-weight: 600; white-space: nowrap; }
	.success-dialog { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 24px; overflow-y: auto; }
	.dialog-backdrop { position: absolute; inset: 0; background: rgba(255, 255, 255, 0.72); backdrop-filter: blur(18px); }
	:global([data-theme="dark"]) .dialog-backdrop { background: rgba(10, 10, 15, 0.85); }
	.dialog-panel { position: relative; width: min(640px, 100%); max-height: calc(100dvh - 48px); overflow-y: auto; overscroll-behavior: contain; border: 1px solid transparent; border-radius: 8px; background: linear-gradient(var(--surface-solid), var(--surface-solid)) padding-box, var(--gradient-border) border-box; box-shadow: 0 30px 110px rgba(0, 0, 0, 0.18); padding: 24px; animation: dialogIn 260ms ease-out; }
	:global([data-theme="dark"]) .dialog-panel { box-shadow: 0 30px 110px rgba(0, 0, 0, 0.6); }
	.dialog-close { position: absolute; top: 14px; right: 14px; display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--line); border-radius: 50%; background: var(--surface-solid); color: var(--muted); font-size: 14px; }
	.dialog-status { width: 54px; height: 54px; margin-bottom: 16px; border-radius: 50%; background: var(--btn-bg); position: relative; animation: successPop 520ms ease-out; }
	.dialog-status::after { content: ""; position: absolute; left: 18px; top: 14px; width: 15px; height: 24px; border-right: 4px solid var(--btn-color); border-bottom: 4px solid var(--btn-color); transform: rotate(45deg); }
	.dialog-panel h2 { margin: 0 34px 8px 0; font-size: 34px; line-height: 1.1; color: var(--ink); }
	.dialog-meta { margin: 0 0 18px; color: var(--muted); font-size: 14px; line-height: 22px; }
	.download-options { display: grid; gap: 12px; }
	.option-row label { display: block; margin-bottom: 6px; color: var(--muted); font-size: 12px; font-weight: 600; text-transform: uppercase; }
	.option-row div { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
	.option-row input { min-width: 0; height: 40px; border: 1px solid var(--input-border); border-radius: 6px; background: var(--input-bg); padding: 0 12px; color: var(--ink); font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace; font-size: 13px; }
	.option-row button, .qr-section a { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; border: 1px solid var(--btn-bg); border-radius: 6px; background: var(--btn-bg); color: var(--btn-color); padding: 0 12px; text-decoration: none; font-size: 13px; font-weight: 600; white-space: nowrap; }
	.dialog-actions { display: flex; flex-wrap: wrap; gap: 8px; }
	.qr-section a.whatsapp-share { border-color: #1fa855; background: #1fa855; color: #ffffff; }
	.qr-section { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: center; margin-top: 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--card-inner); padding: 14px; }
	.qr-section img { width: 132px; height: 132px; border: 1px solid var(--line); border-radius: 8px; background: #ffffff; padding: 8px; }
	.qr-section strong, .qr-section span { display: block; }
	.qr-section strong { color: var(--ink); }
	.qr-section span { margin: 6px 0 12px; color: var(--muted); font-size: 14px; line-height: 21px; }
	@media (prefers-reduced-motion: reduce) { .upload-icon::before, .dropzone::before { animation: none; } }
	@media (max-width: 860px) { .upload-layout { grid-template-columns: 1fr; width: min(720px, calc(100% - 32px)); } }
	@media (max-width: 560px) {
		.success-dialog { place-items: start center; padding: 12px; }
		.dialog-panel { max-height: calc(100dvh - 24px); padding: 18px; }
		.dialog-panel h2 { margin-right: 28px; font-size: 28px; }
		.dialog-status { width: 44px; height: 44px; margin-bottom: 12px; }
		.dialog-status::after { left: 15px; top: 11px; width: 12px; height: 20px; }
		.option-row div, .qr-section { grid-template-columns: 1fr; }
		.dialog-actions { display: grid; grid-template-columns: 1fr; }
		.qr-section img { width: 112px; height: 112px; }
	}
</style>
